# Copy this file to .env for local overrides. Do not commit .env files.
CIVICFIX_ENVIRONMENT=development
CIVICFIX_LOG_LEVEL=INFO
CIVICFIX_SERVICE_NAME=civicfix-ai-service
CIVICFIX_API_PREFIX=/api/v1
# Model artifacts are optional in Phase 2. No configured artifact means unavailable.
CIVICFIX_MODEL_ARTIFACT_DIR=./artifacts/models
# Optional pretrained CLIP scene classifier (needs requirements-clip.txt). 1 = enabled.
CIVICFIX_ENABLE_CLIP=0
CIVICFIX_SCENE_MODEL=openai/clip-vit-base-patch32

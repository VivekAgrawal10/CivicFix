# CivicBot Backend Configuration

# Server Port
PORT=5000

# Google Gemini API Key (Required)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Defaults to gemini-3.5-flash if not specified)
# Options: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash

# Frontend URL for CORS configuration (comma separated if multiple)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

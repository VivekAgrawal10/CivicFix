# ── CivicFix backend (Express) ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Database — MySQL 8 is the only database.
# The schema is created automatically on startup (or run `npm run db:init`); `npm run seed` adds demo data.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=civicfix_db
# MYSQL_CONNECTION_LIMIT=10

# Auth — generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS: comma-separated frontend origins
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Image storage: leave Cloudinary values as-is to store uploads on local disk (backend/uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
FIREBASE_SERVICE_ACCOUNT_KEY=

# AI + chatbot services
AI_SERVICE_URL=http://localhost:8000
CHATBOT_URL=http://localhost:5001
# AI_TIMEOUT_MS=60000          # first CLIP request can be slow while the model loads
# AI_STRICT=false              # true = reject reports with photos when the AI service is down
# IMAGE_FETCH_ALLOWED_HOSTS=res.cloudinary.com,localhost,127.0.0.1
# RATE_LIMIT_MAX=300
# CLUSTER_RADIUS_M=100          # reports of the same kind within this many metres of the first report count as the same problem

{
  "name": "civicfix-backend",
  "version": "1.0.0",
  "description": "CivicFix civic issue reporting backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/db/init.js",
    "seed": "node src/seeds/seed.js",
    "test:admin": "node --no-warnings tests/admin.test.js",
    "test:clusters": "node --no-warnings tests/clusters.test.js",
    "test:endpoints": "node --no-warnings tests/endpoints.test.js",
    "test": "node tests/api.test.js && node tests/ai-client.test.js && node tests/report-flow.test.js && node tests/endpoints.test.js && node tests/admin.test.js && node tests/clusters.test.js && node tests/image-metadata.test.js"
  },
  "dependencies": {
    "axios": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.3",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}

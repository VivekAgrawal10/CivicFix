# Express API base URL (default shown)
VITE_API_URL=http://localhost:5000/api/v1

# Live map (Leaflet). Leaflet and the default OpenStreetMap tiles need NO API key.
# Only set these if you want a keyed tile provider such as MapTiler / Stadia / Thunderforest:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key={key}
# VITE_MAP_API_KEY=your_key
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
